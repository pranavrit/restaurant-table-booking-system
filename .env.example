# Copy to .env or export in your shell. Never commit the real values.
TBS_SECRET_KEY=change-me-to-a-long-random-string
TBS_BASE_URL=https://bookings.example.com
TBS_MAIL_BACKEND=console        # console writes e-mails to instance/outbox; smtp sends them
TBS_MAIL_SENDER=bookings@example.com
TBS_SMTP_HOST=smtp.example.com
TBS_SMTP_PORT=587
TBS_SMTP_USER=
TBS_SMTP_PASSWORD=
TBS_MAIL_HOURLY_LIMIT=0         # 0 means no limit
TBS_FORCE_HTTPS=0               # set to 1 behind HTTPS in production
